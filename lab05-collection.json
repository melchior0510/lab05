{
  "info": {
    "name": "Lab05",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Happy path: идэвхтэй оюутан, урьдач хангасан → 201 OK",
      "item": [
        {
          "name": "setup оюутан",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/S_T1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S_T1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "setup хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/C_T1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C_T1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Happy path бүртгэл - статус 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Happy path бүртгэл - result=OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID тоо байна\", function () { pm.expect(pm.response.json().registrationID).to.be.a(\"number\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"S_T1\",\"courseID\":\"C_T1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
